# ==========================================
# BalatroLLM Configuration File
# ==========================================

# Bridge Connection (IP of your phone in local Wi-Fi or 127.0.0.1 for local/Termux)
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=12346

# --------------------------------------------------------------------------
# Provider Option 1: Custom OpenAI-compatible Proxy (Apinex, Cursor, Groq, etc.)
# --------------------------------------------------------------------------
PROVIDER=custom
CUSTOM_BASE_URL=https://api.apinex.bond/v1
CUSTOM_API_KEY=your_api_key_here
MODEL=free/gpt-6-luna

# --------------------------------------------------------------------------
# Provider Option 2: OpenRouter
# --------------------------------------------------------------------------
# PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-your-openrouter-key-here
# MODEL=anthropic/claude-3.5-sonnet

# --------------------------------------------------------------------------
# Provider Option 3: Direct OpenAI
# --------------------------------------------------------------------------
# PROVIDER=openai
# OPENAI_API_KEY=sk-...
# MODEL=gpt-4o

# --------------------------------------------------------------------------
# Provider Option 4: Direct Anthropic
# --------------------------------------------------------------------------
# PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-3-5-sonnet-20241022

# --------------------------------------------------------------------------
# Agent Execution Parameters
# --------------------------------------------------------------------------
DRY_RUN=false
VERBOSE_COT=true
TEMPERATURE=0.2
POLL_INTERVAL=1.0
ACTION_COOLDOWN=1.0
ANIMATION_DELAY=1.5
CASH_OUT_DELAY=3
BRIDGE_MAX_DISCONNECT_FAILURES=5
BRIDGE_MAX_DISCONNECT_SECONDS=300.0
